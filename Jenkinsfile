pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'GitHub repository checkout completed'
            }
        }

        stage('Build') {
            steps {
                echo 'Building application...'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing application...'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment stage completed'
            }
        }
    }
}